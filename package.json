{
  "name": "zhiji",
  "productName": "职迹",
  "version": "0.1.0",
  "description": "职迹：本地优先的求职管理工具",
  "main": "out/main/index.js",
  "author": "Zhiji",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm rebuild:native && electron-vite dev",
    "build": "pnpm rebuild:native && electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "pnpm rebuild:node && vitest run",
    "test:watch": "vitest",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "pnpm rebuild better-sqlite3",
    "postinstall": "electron-builder install-app-deps",
    "package:win": "pnpm build && electron-builder --win dir",
    "release:win": "pnpm package:win && node scripts/pack-velopack.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "naive-ui": "^2.43.2",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-i18n": "^11.1.11",
    "velopack": "^1.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.21",
    "@electron/rebuild": "^4.0.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12"
  },
  "build": {
    "appId": "zhiji",
    "productName": "职迹",
    "executableName": "zhiji",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/velopack/**/*"
    ],
    "files": [
      "out/**/*",
      "build/icon.png",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "dir"
    }
  },
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}
